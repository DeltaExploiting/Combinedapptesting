# Never commit real values.
CERTS_ROOT=./certs
OUTPUT_DIR=./public
PUBLIC_BASE_URL=https://signing.example.com

# Optional but strongly recommended. If set, the app must send the same
# value in an Authorization header. The current client can be extended with
# this token when the service is deployed behind authentication.
SIGNING_API_TOKEN=replace-with-a-long-random-token

# Only map certificate display names to local administrator-controlled aliases.
# Example:
# CERTIFICATE_MAP={"My Authorized Certificate":"team1"}
CERTIFICATE_MAP={}

# The corresponding password is supplied only as an environment variable:
# P12_PASSWORD_team1=do-not-commit-this
